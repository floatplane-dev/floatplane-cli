#!/bin/bash

set -e

echo "----------"
echo "Floatplane CLI"
echo "----------"

# Directory the user ran `fp` from (needed for project files like .fprc)
caller_dir=$(pwd)

# Get the work directory in which this file is located.
wd=$(dirname -- "$(readlink -f -- "$0")")

# Go to the directory with all the scripts
cd $wd
cd ../scripts

# fp setup
# Asks whether you want to set up a server or app
if [ "$1" == 'setup' ] && [ -z $2 ];
then
  sh ./setup.sh "$caller_dir"
  exit 0
fi

# fp setup server
# Asks questions and then sets up server
if [ "$1" == 'setup' ] && [ "$2" == 'server' ];
then
  sh ./setup-server.sh
  exit 0
fi

# fp setup app
# Asks questions and then sets up app on server
if [ "$1" == 'setup' ] &&  [ "$2" == 'app' ];
then
  sh ./setup-app.sh "$caller_dir"
  exit 0
fi

if [ "$1" == 'deploy' ];
then
  ./deploy.sh "$caller_dir"
  exit 0
fi

if [ -z "$1" ];
then
  echo "What do you wish to do?"
  options=("setup server 🗿" "setup app 🌱" "deploy 🚀")
  select option in "${options[@]}"; do
    [ "$option" ] && break
    echo "Please enter a number from the list."
  done
  [ "$option" == "setup server 🗿" ] && ./setup-server.sh
  [ "$option" == "setup app 🌱" ] && ./setup-app.sh "$caller_dir"
  [ "$option" == "deploy 🚀" ] && ./deploy.sh "$caller_dir"
  
  echo "----------"
fi

echo "⛵"
echo "----------"